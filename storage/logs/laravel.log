                </tr>
                <tr>
                    <td style="padding: 8px; border-bottom: 1px solid #e5e7eb;"><strong>Lokasi</strong></td>
                    <td style="padding: 8px; border-bottom: 1px solid #e5e7eb;">merak</td>
